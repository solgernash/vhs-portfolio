{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project. `name` must match the project's name in the dashboard.
  // Pages serves dist/ as static files (404.html for unknown addresses, _headers for headers)
  // and runs functions/ as the API: functions/api/now-playing.js answers /api/now-playing.
  "name": "vhs-portfolio",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-05-01"
}
